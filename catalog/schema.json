{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppCatalog",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "version": {
      "type": "string"
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "description", "category", "status", "frontend", "backend"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string", "enum": ["live", "development", "planned"] },
          "frontend": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "framework": { "type": "string" }
            }
          },
          "backend": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "framework": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
