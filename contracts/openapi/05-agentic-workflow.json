{
  "components": {
    "schemas": {
      "AgentSessionResponse": {
        "properties": {
          "final_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Answer"
          },
          "pending_approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingApproval"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "session_token": {
            "title": "Session Token",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "session_id",
          "session_token",
          "status",
          "steps",
          "request_id"
        ],
        "title": "AgentSessionResponse",
        "type": "object"
      },
      "AgentStep": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "step_index": {
            "title": "Step Index",
            "type": "integer"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "number"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "tool_args": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Args"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          },
          "tool_result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Result"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "step_index",
          "type",
          "title",
          "content"
        ],
        "title": "AgentStep",
        "type": "object"
      },
      "ApproveTaskRequest": {
        "properties": {
          "approved": {
            "title": "Approved",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "session_id": {
            "minLength": 1,
            "title": "Session Id",
            "type": "string"
          },
          "session_token": {
            "maxLength": 128,
            "minLength": 32,
            "title": "Session Token",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "session_token",
          "approved"
        ],
        "title": "ApproveTaskRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PendingApproval": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "tool_args": {
            "additionalProperties": true,
            "title": "Tool Args",
            "type": "object"
          },
          "tool_name": {
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "tool_name",
          "tool_args",
          "message"
        ],
        "title": "PendingApproval",
        "type": "object"
      },
      "RunTaskRequest": {
        "properties": {
          "prompt": {
            "description": "Task prompt for the agent",
            "maxLength": 1000,
            "minLength": 2,
            "title": "Prompt",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "session_token": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Token"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "RunTaskRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "App 05: Agentic Workflow Backend",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/agent/approve": {
      "post": {
        "operationId": "approve_agent_endpoint_api_agent_approve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveTaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Approve Agent Endpoint"
      }
    },
    "/api/agent/run": {
      "post": {
        "operationId": "run_agent_endpoint_api_agent_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunTaskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Agent Endpoint"
      }
    },
    "/api/agent/session/{session_id}": {
      "get": {
        "operationId": "get_session_endpoint_api_agent_session__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Session-Token",
            "required": true,
            "schema": {
              "title": "X-Session-Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session Endpoint"
      }
    },
    "/health": {
      "get": {
        "description": "Sanitized health check exposing no internal infrastructure details.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    }
  }
}
