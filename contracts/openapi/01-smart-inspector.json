{
  "components": {
    "schemas": {
      "AnalysisResult": {
        "properties": {
          "averagePrice": {
            "default": "",
            "description": "The average price of the item in the image.",
            "title": "Averageprice",
            "type": "string"
          },
          "caption": {
            "default": "",
            "description": "One-line description of the image.",
            "title": "Caption",
            "type": "string"
          },
          "lowestPriceLink": {
            "default": "",
            "description": "The link to the lowest price of the item online, if applicable.",
            "title": "Lowestpricelink",
            "type": "string"
          },
          "objects": {
            "description": "Detected objects in the image.",
            "items": {
              "type": "string"
            },
            "title": "Objects",
            "type": "array"
          },
          "ocr": {
            "default": "",
            "description": "All visible text in the image.",
            "title": "Ocr",
            "type": "string"
          },
          "tags": {
            "description": "Short keyword tags.",
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "title": "AnalysisResult",
        "type": "object"
      },
      "Body_analyze_analyze_post": {
        "properties": {
          "image": {
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "type": "string"
          },
          "language": {
            "default": "de",
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "title": "Body_analyze_analyze_post",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Smart Inspector",
    "version": "1.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/analyze": {
      "post": {
        "operationId": "analyze_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze"
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
