{
  "components": {
    "schemas": {
      "GenerateMeta": {
        "properties": {
          "cost": {
            "title": "Cost",
            "type": "number"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "integer"
          },
          "persona": {
            "title": "Persona",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenUsage"
          }
        },
        "required": [
          "request_id",
          "latency_ms",
          "tokens",
          "cost",
          "persona"
        ],
        "title": "GenerateMeta",
        "type": "object"
      },
      "GenerateRequest": {
        "properties": {
          "audience": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "brief": {
            "maxLength": 2000,
            "minLength": 20,
            "title": "Brief",
            "type": "string"
          },
          "format": {
            "default": "linkedin",
            "enum": [
              "linkedin",
              "email",
              "landing"
            ],
            "title": "Format",
            "type": "string"
          },
          "language": {
            "default": "en",
            "enum": [
              "en",
              "pt-BR",
              "de"
            ],
            "title": "Language",
            "type": "string"
          },
          "maxTokens": {
            "default": 700,
            "maximum": 1600.0,
            "minimum": 200.0,
            "title": "Maxtokens",
            "type": "integer"
          },
          "persona": {
            "default": "friendly",
            "enum": [
              "friendly",
              "technical",
              "cfo"
            ],
            "title": "Persona",
            "type": "string"
          },
          "temperature": {
            "default": 0.7,
            "maximum": 1.5,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          },
          "topP": {
            "default": 0.9,
            "maximum": 1.0,
            "minimum": 0.1,
            "title": "Topp",
            "type": "number"
          }
        },
        "required": [
          "brief"
        ],
        "title": "GenerateRequest",
        "type": "object"
      },
      "GenerateResponse": {
        "properties": {
          "data": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/Variation"
              },
              "type": "array"
            },
            "title": "Data",
            "type": "object"
          },
          "meta": {
            "$ref": "#/components/schemas/GenerateMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "GenerateResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SafetyRequest": {
        "properties": {
          "text": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "SafetyRequest",
        "type": "object"
      },
      "SafetyResponse": {
        "properties": {
          "categories": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Categories",
            "type": "object"
          },
          "safe": {
            "title": "Safe",
            "type": "boolean"
          },
          "severity": {
            "items": {
              "type": "string"
            },
            "title": "Severity",
            "type": "array"
          }
        },
        "required": [
          "safe"
        ],
        "title": "SafetyResponse",
        "type": "object"
      },
      "TokenUsage": {
        "properties": {
          "completion": {
            "title": "Completion",
            "type": "integer"
          },
          "prompt": {
            "title": "Prompt",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "prompt",
          "completion",
          "total"
        ],
        "title": "TokenUsage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Variation": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "seoKeywords": {
            "items": {
              "type": "string"
            },
            "title": "Seokeywords",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "body"
        ],
        "title": "Variation",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "promptForge",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
