# Azure OpenAI — endpoint must include /openai/v1 (Azure OpenAI v1 API).
AZURE_OPENAI_ENDPOINT=https://<resource-name>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_KEY=<api-key>

# Server
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Local Storage Paths
UPLOAD_DIR=./data/uploads
METADATA_DB_PATH=./data/metadata.sqlite3

# Local ingestion and retrieval limits
MAX_FILE_BYTES=10485760
MAX_PAGES=200
MAX_TEXT_CHARS=2000000
MAX_CHUNKS_PER_DOCUMENT=1000
MAX_DOCUMENTS=100
UPLOAD_RETENTION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=60
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=50
MIN_RELEVANCE_SCORE=0.2
MAX_QUESTION_CHARS=2000
MAX_CONTEXT_CHARS=16000

# Local development enables generation by default when this variable is omitted.
# Keep the explicit production kill switch disabled until credentials and limits are ready.
GENERATION_ENABLED=false
POCKET_RAG_API_KEY=<generate-a-long-random-secret>
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=1
MAX_OUTPUT_TOKENS=700
MAX_CONCURRENT_GENERATIONS=2
REQUESTS_PER_MINUTE=10
DAILY_GENERATION_LIMIT=200
INPUT_COST_PER_MILLION_USD=0.15
OUTPUT_COST_PER_MILLION_USD=0.60
