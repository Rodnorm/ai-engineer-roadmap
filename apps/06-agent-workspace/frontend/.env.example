AGENT_PROVIDER=offline
GENERATION_ENABLED=true
REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=2

# Required in production. Generate at least 32 random bytes.
CONVERSATION_SESSION_SECRET=

MCP_SERVER_URL=http://localhost:8006
INTERNAL_API_TOKEN=

# Required only for AGENT_PROVIDER=foundry
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_AGENT_NAME=agent-workspace
AZURE_AI_MODEL_DEPLOYMENT_NAME=
PUBLIC_MCP_SERVER_URL=https://mcp-app06.example.com/mcp
AZURE_AI_MCP_CONNECTION_NAME=

# DefaultAzureCredential service principal values for containers
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional durable persistence. Without it, conversations stay in process memory.
# conversations-v2 uses /ownerId as its partition key; the previous container is not migrated automatically.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE_NAME=agent-workspace
COSMOS_CONTAINER_NAME=conversations-v2
