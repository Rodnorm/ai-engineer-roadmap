# App 08: Production AI Deployment & Operations Studio Configuration

# Execution Mode: "offline" (mock deterministic simulator) or "online" (real Azure OpenAI calls)
APP_MODE=offline
PORT=3008

# Azure OpenAI Credentials (reused from existing setup)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_CANDIDATE=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Master Deployment & Cost Kill-Switch
DEPLOY_ENABLED=true

# Security & Concurrency Limits
RATE_LIMIT_REQUESTS_PER_MINUTE=10
MAX_CONCURRENCY=2

# Session Secret (HMAC-SHA256 signature for owner cookie)
SESSION_SECRET=dev-app08-ai-ops-secret-key-32-chars-minimum
