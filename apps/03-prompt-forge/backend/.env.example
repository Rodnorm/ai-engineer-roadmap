# Azure OpenAI — endpoint must include /openai/v1 (Azure OpenAI v1 API).
AZURE_OPENAI_ENDPOINT=https://<resource-name>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_KEY=<openai-api-key>

# Server
PORT=8000
LOG_LEVEL=INFO

# Generation guards
AZURE_MAX_OUTPUT_TOKENS=1600
AZURE_REQUEST_TIMEOUT_SECONDS=30

# Cost estimation (USD per 1k tokens) — used if usage is missing
COST_PROMPT_PER_1K=0.00015
COST_COMPLETION_PER_1K=0.0006
