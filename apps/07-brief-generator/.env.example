# Multi-Agent Brief Generator Environment Variables

# Execution Mode: "offline" (deterministic mocks, zero API cost) or "online" (Azure OpenAI)
APP_MODE=offline

# Azure OpenAI Configuration (required if APP_MODE=online)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Security & Concurrency Controls
GENERATION_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=10
MAX_RESEARCH_ROUNDS=3
CONVERSATION_SESSION_SECRET=at-least-32-characters-secret-key-for-session-tokens

# Server Port
PORT=3007

