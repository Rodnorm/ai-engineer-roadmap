# Environment & Server
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Azure AI Agent & Language Credentials
AZURE_AGENT_NAME=<agent-name>
AZURE_AGENT_VERSION=<agent-version>
AZURE_AGENT_ENDPOINT=<agent-endpoint>
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>
AZURE_LANGUAGE_ENDPOINT=<language-service-endpoint>

# Master Kill Switch
GENERATION_ENABLED=true

# Request Guards
MAX_QUERY_LENGTH=2000
AZURE_MAX_OUTPUT_TOKENS=800
AZURE_REQUEST_TIMEOUT_SECONDS=30.0

# Cost and Abuse Guards
MAX_CONCURRENT_REQUESTS=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=3
RATE_LIMIT_REQUESTS_PER_DAY_PER_IP=20
RATE_LIMIT_GLOBAL_REQUESTS_PER_DAY=100

# Proxy Trust
TRUST_PROXY_HEADERS=true
