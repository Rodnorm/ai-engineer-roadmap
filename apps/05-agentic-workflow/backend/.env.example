APP_ENV=development
PORT=8005
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005

# Azure OpenAI configuration (Optional: offline fallback works out-of-the-box)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Security & Limits
GENERATION_ENABLED=true
MAX_CONCURRENT_REQUESTS=2
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=500
AZURE_MAX_OUTPUT_TOKENS=800
AZURE_REQUEST_TIMEOUT_SECONDS=30.0

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_DAY_PER_IP=100
RATE_LIMIT_GLOBAL_REQUESTS_PER_DAY=500
