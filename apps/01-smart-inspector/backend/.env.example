# Azure OpenAI — endpoint must include /openai/v1 (Azure OpenAI v1 API).
AZURE_OPENAI_ENDPOINT=https://<resource-name>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_KEY=<openai-api-key>

# Server
PORT=8000
LOG_LEVEL=INFO

# Upload and Azure request guards
MAX_IMAGE_BYTES=5242880
AZURE_MAX_OUTPUT_TOKENS=800
AZURE_REQUEST_TIMEOUT_SECONDS=30

# Cost and abuse guards
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=5
RATE_LIMIT_REQUESTS_PER_DAY_PER_IP=30
RATE_LIMIT_GLOBAL_REQUESTS_PER_DAY=300

# Trust x-forwarded-for only behind a trusted proxy such as Vercel.
# Set to false when exposing Uvicorn directly to the internet.
TRUST_PROXY_HEADERS=true
