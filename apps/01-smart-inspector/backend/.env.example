# Azure OpenAI — endpoint must include /openai/v1 (Azure OpenAI v1 API).
AZURE_OPENAI_ENDPOINT=https://<resource-name>.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_KEY=<openai-api-key>

# Environment & Server
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Master Kill Switch
GENERATION_ENABLED=true

# Image Upload Security Guards
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
MAX_IMAGE_PIXELS=24000000

# Azure Request Guards
AZURE_MAX_OUTPUT_TOKENS=800
AZURE_REQUEST_TIMEOUT_SECONDS=30.0

# Cost and Abuse Guards
MAX_CONCURRENT_REQUESTS=2
RATE_LIMIT_ENABLED=true
# Required in production. Generate a unique secret with at least 32 random characters.
RATE_LIMIT_HASH_KEY=
RATE_LIMIT_REQUESTS_PER_MINUTE=3
RATE_LIMIT_REQUESTS_PER_DAY_PER_IP=20
RATE_LIMIT_GLOBAL_REQUESTS_PER_DAY=100
# Mount /data as a persistent Coolify volume in production.
RATE_LIMIT_DB_PATH=/data/rate-limit.sqlite3

# Proxy Trust
TRUST_PROXY_HEADERS=false
# Example after confirming the actual Coolify/Traefik network: 172.16.0.0/12
TRUSTED_PROXY_CIDRS=
